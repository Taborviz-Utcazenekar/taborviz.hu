---
interface Props {
  avatar: string;
  name: string;
  description: string;
}

const { avatar, name, description } = Astro.props;
---

<div
  class:list={[
    "card",
    "bg-base-100",
    "shadow-xl",
    "transition",
    "hover:shadow-2xl",
    "hover:-translate-y-1",
    "mt-16",
  ]}
>
  <div class="avatar -mt-16">
    <div class="w-32 rounded-full">
      <img src={avatar} />
    </div>
  </div>
  <div class="card-body text-center">
    <h3 class="card-title justify-center">{name}</h3>
    <p class="text-base-content/70 text-sm text-balance">{description}</p>
  </div>
</div>
