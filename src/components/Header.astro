---
/**
 * Mostly copied from the responsive navbar component example:
 * https://daisyui.com/components/navbar/#responsive-collapse-on-small-screen-full-content-on-large-screen
 */

import MenuIcon from "./MenuIcon.astro";

const pathname = Astro.url.pathname;
const isActive = (href) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const linkClass = (href) => (isActive(href) ? "font-semibold" : "");
---

<header
  class:list={[
    "max-md:collapse",
    "shadow-sm",
    "w-full",
    "rounded-md",
    "sticky",
    "top-0",
    "z-50",
    "bg-base-200",
  ]}
>
  <input id="navbar-toggle" class="peer hidden" type="checkbox" />
  <label
    for="navbar-toggle"
    class="fixed inset-0 hidden max-md:peer-checked:block"></label>
  <div class="collapse-title navbar">
    <div class="navbar-start">
      <label for="navbar-toggle" class="btn btn-ghost md:hidden">
        <MenuIcon />
      </label>
      <a href="/" class="btn btn-ghost text-xl">⛲ Táborvíz</a>
    </div>
    <nav class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal px-1">
        <li><a class={linkClass("/")} href="/">Rólunk</a></li>
        <li><a class={linkClass("/tagok")} href="/tagok">Tagok</a></li>
        <li>
          <details>
            <summary class={linkClass("/dalok")}>Dalok</summary>
            <ul class="p-2 bg-base-100 w-40 z-1">
              <li><a href="/dalok#magyar">🇭🇺 Magyar</a></li>
              <li><a href="/dalok#angol">🇬🇧 Angol</a></li>
            </ul>
          </details>
        </li>
        <li><a class={linkClass("/media")} href="/media">Média</a></li>
      </ul>
    </nav>
    <div class="navbar-end">
      <div class="flex gap-0.5 text-xl px-4">
        <span>🎵</span>
        <span class="translate-y-1">🎸</span>
        <span class="-translate-y-1">🎤</span>
        <span class="translate-y-1">🎹</span>
        <span class="-translate-y-1">🥁</span>
        <span>🎶</span>
      </div>
    </div>
  </div>
  <nav class="collapse-content md:hidden z-1">
    <ul class="menu">
      <li><a class={linkClass("/")} href="/">Rólunk</a></li>
      <li><a class={linkClass("/tagok")} href="/tagok">Tagok</a></li>
      <li>
        <a class={linkClass("/dalok")} href="/dalok">Dalok</a>
        <ul>
          <li><a href="/dalok#magyar">🇭🇺 Magyar</a></li>
          <li><a href="/dalok#angol">🇬🇧 Angol</a></li>
        </ul>
      </li>
      <li><a class={linkClass("/media")} href="/media">Média</a></li>
    </ul>
  </nav>
</header>
